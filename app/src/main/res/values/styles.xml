<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type scale. Layouts pick one of these instead of setting sizes inline. -->
    <style name="Text" />
    <style name="Text.Title">
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="fontFamily">@font/bricolage_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Title.Small">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="Text.Number">
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="fontFamily">@font/bricolage_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Section">
        <item name="android:fontFamily">@font/instrument_bold</item>
        <item name="fontFamily">@font/instrument_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Body.Strong">
        <item name="android:fontFamily">@font/instrument_semibold</item>
        <item name="fontFamily">@font/instrument_semibold</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Text.Label">
        <item name="android:fontFamily">@font/instrument_semibold</item>
        <item name="fontFamily">@font/instrument_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Text.Mono">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Text.Tag">
        <item name="android:fontFamily">@font/instrument_semibold</item>
        <item name="fontFamily">@font/instrument_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Buttons -->
    <style name="Button" />
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/instrument_semibold</item>
        <item name="fontFamily">@font/instrument_semibold</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="iconTint">@color/button_primary_text</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/instrument_semibold</item>
        <item name="fontFamily">@font/instrument_semibold</item>
        <item name="android:textColor">@color/text</item>
        <item name="iconTint">@color/text</item>
        <item name="strokeColor">@color/field_outline</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/instrument_semibold</item>
        <item name="fontFamily">@font/instrument_semibold</item>
        <item name="android:textColor">@color/green_text</item>
        <item name="iconTint">@color/green_text</item>
    </style>

    <!-- Form fields: a label above a single-line input. -->
    <style name="FieldLabel" parent="Text.Body.Strong">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Field">
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!-- Bottom navigation -->
    <style name="BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/BottomNavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_tint</item>
    </style>
    <style name="BottomNavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/instrument_semibold</item>
        <item name="fontFamily">@font/instrument_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="BottomNavLabel.Active">
        <item name="android:fontFamily">@font/instrument_bold</item>
        <item name="fontFamily">@font/instrument_bold</item>
    </style>

    <!-- Bottom sheets: our own rounded surface. -->
    <style name="ThemeOverlay.Km.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetKm</item>
    </style>
    <style name="BottomSheetKm" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearanceKmSheet</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="ShapeAppearanceKmSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
