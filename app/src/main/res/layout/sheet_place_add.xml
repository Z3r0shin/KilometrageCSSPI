<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <TextView
        style="@style/Text.Title.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="6dp"
        android:text="Ajouter un lieu" />

    <TextView
        android:id="@+id/addHere"
        style="@style/Text.Body.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Ma position actuelle"
        app:drawableStartCompat="@drawable/ic_my_location"
        app:drawableTint="@color/green_text" />

    <TextView
        android:id="@+id/addAddress"
        style="@style/Text.Body.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Une adresse"
        app:drawableStartCompat="@drawable/ic_home"
        app:drawableTint="@color/green_text" />

    <TextView
        android:id="@+id/addCsv"
        style="@style/Text.Body.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Importer un CSV"
        app:drawableStartCompat="@drawable/ic_file"
        app:drawableTint="@color/green_text" />
</LinearLayout>
