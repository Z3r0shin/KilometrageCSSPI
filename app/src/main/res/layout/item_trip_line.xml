<?xml version="1.0" encoding="utf-8"?>
<!-- One line of trips: a single leg, or an aller-retour folded into one row.
     Bound by TripRow; sits inside a card, between dividers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/lineTime"
        style="@style/Text.Mono"
        android:layout_width="46dp"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lineRoute"
            style="@style/Text.Body.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:id="@+id/lineMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lineTag"
                style="@style/Text.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tag_green"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Aller-retour"
                android:textColor="@color/green_text" />

            <TextView
                android:id="@+id/linePo"
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/lineAddPo"
            style="@style/Text.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_amber_inset"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Ajouter le P.O."
            android:textColor="@color/amber_tint_text"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_barcode_small"
            app:drawableTint="@color/amber_tint_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lineKm"
            style="@style/Text.Body.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lineKmDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/lineMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="-10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Options du trajet"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/text_muted" />
</LinearLayout>
