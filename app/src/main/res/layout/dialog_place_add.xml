<?xml version="1.0" encoding="utf-8"?>
<!-- Fields of the two "add a place" dialogs; adding at the current position
     hides the address. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp">

    <EditText
        android:id="@+id/addPlaceName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_field"
        android:hint="Nom (doit matcher la table km)"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/addPlaceAddress"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:hint="Adresse complète"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp" />
</LinearLayout>
