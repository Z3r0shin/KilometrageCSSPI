<?xml version="1.0" encoding="utf-8"?>
<!-- One filter chip of the Trajets screen: a 36dp pill centred in a 48dp
     touch target. TripsActivity sets its colours, label and check mark. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/chipPill"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/chipCheck"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            app:tint="@color/green_text" />

        <TextView
            android:id="@+id/chipText"
            style="@style/Text.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
