<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scan_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Three bands over the camera. The outer two and the sides of the middle
         one carry the scrim, which leaves the viewfinder as the clear window.
         Spare height is shared 4:5, so the frame sits a little above centre. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:background="@color/scan_scrim"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/scanClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_scan_round"
                    android:contentDescription="Fermer"
                    android:src="@drawable/ic_close"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/scanTorch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_scan_round"
                    android:contentDescription="Lampe"
                    android:src="@drawable/ic_torch"
                    android:visibility="gone"
                    app:tint="@color/scan_torch" />
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/instrument_semibold"
                android:gravity="center"
                android:text="Placez le code-barres dans le cadre"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Tenez-le à l\'horizontale, sans bouger"
                android:textColor="@color/scan_text_soft"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:orientation="horizontal">

            <View
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:background="@color/scan_scrim" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/scan_frame_corner" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:importantForAccessibility="no"
                    android:rotation="90"
                    android:src="@drawable/scan_frame_corner" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:importantForAccessibility="no"
                    android:rotation="180"
                    android:src="@drawable/scan_frame_corner" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|start"
                    android:importantForAccessibility="no"
                    android:rotation="270"
                    android:src="@drawable/scan_frame_corner" />
            </FrameLayout>

            <View
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:background="@color/scan_scrim" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:background="@color/scan_scrim"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_scan_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_medium"
                    android:text="Code lu"
                    android:textColor="@color/scan_label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/scanCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/jetbrains_mono_medium"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="Recherche…"
                    android:textColor="@color/white"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/scanDot1"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_dot_ring" />

                    <View
                        android:id="@+id/scanDot2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_dot_ring" />

                    <View
                        android:id="@+id/scanDot3"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_dot_ring" />

                    <TextView
                        android:id="@+id/scanVerify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Vérification 0 sur 3"
                        android:textColor="@color/scan_text_soft"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/scanManual"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_scan_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/instrument_semibold"
                android:gravity="center"
                android:text="Saisir le numéro à la main"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
