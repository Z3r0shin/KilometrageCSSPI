<?xml version="1.0" encoding="utf-8"?>
<!-- The state dot of the status card: amber with a halo while detection is
     active (state_activated), a dim dot otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/today_dot_halo" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/amber" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <solid android:color="@color/hero_track" />
            </shape>
        </inset>
    </item>
</selector>
